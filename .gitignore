# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Factory runtime state (never committed; lives under C:\Factory)
*.db
*.db-journal

# Local secrets / env (never committed; ADR-003)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db

# Build output (esbuild bundles for Cloudflare Workers — regenerated by `npm run build` / `wrangler deploy`)
factory/intake/worker/dist/

# Node dependencies and local Wrangler/Miniflare dev state — regenerated per machine by
# `npm install` / `wrangler dev`. Was previously (wrongly) committed, including Windows-only
# native binaries (@esbuild/win32-x64, @cloudflare/workerd-windows-64, sharp-win32-x64) that
# broke cross-platform (e.g. macOS) checkouts. See docs/operations/CROSS_MACHINE_DEV_WORKFLOW.md.
node_modules/
.wrangler/
